# Telegram RAG Bot Configuration

# Обязательные
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
OPENAI_API_KEY=your_openai_or_mistral_api_key

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///bot.db

# AI (Mistral — бесплатно, fallback)
MISTRAL_API_KEY=your_mistral_api_key
DEFAULT_MODEL=mistral-small-latest

# GigaChat (Сбер) — первичный LLM-провайдер (ключ обычно в ~/.env)
GIGACHAT_AUTH_KEY=base64_your_credentials
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max

# Опционально
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=change-this-in-production
